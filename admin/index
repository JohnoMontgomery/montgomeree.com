<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — montgomeree</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #F8F7F3;
      --ink: #1C1C19;
      --muted: #8C8C84;
      --rule: #D8D7D0;
      --accent: #1C1C19;
      --font: 'Roboto', sans-serif;
    }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--ink);
      min-height: 100vh;
      padding: 2rem 1.5rem;
      -webkit-font-smoothing: antialiased;
    }

    .wrapper { max-width: 720px; margin: 0 auto; }

    /* ── Screens ── */
    .screen { display: none; }
    .screen.active { display: block; }

    /* ── Login ── */
    .login-box {
      max-width: 360px;
      margin: 8rem auto;
    }

    .login-box h1 {
      font-size: 2rem;
      font-weight: 300;
      margin-bottom: 0.25rem;
    }

    .login-box p {
      color: var(--muted);
      font-size: 0.85rem;
      margin-bottom: 2rem;
    }

    /* ── Setup ── */
    .setup-box { max-width: 480px; margin: 4rem auto; }
    .setup-box h2 { font-weight: 400; font-size: 1.3rem; margin-bottom: 0.5rem; }
    .setup-box p { color: var(--muted); font-size: 0.85rem; margin-bottom: 2rem; line-height: 1.6; }

    /* ── Header bar ── */
    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--rule);
      margin-bottom: 2rem;
    }

    .admin-header h1 { font-size: 1.2rem; font-weight: 400; }
    .admin-header span { font-size: 0.75rem; color: var(--muted); }

    /* ── Form ── */
    .field { margin-bottom: 1.5rem; }

    label {
      display: block;
      font-size: 0.72rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.4rem;
      font-weight: 500;
    }

    input[type="text"],
    input[type="date"],
    input[type="password"],
    textarea,
    select {
      width: 100%;
      background: white;
      border: 1px solid var(--rule);
      border-radius: 3px;
      padding: 0.6rem 0.75rem;
      font-family: var(--font);
      font-size: 1rem;
      color: var(--ink);
      outline: none;
      transition: border-color 0.15s;
    }

    input:focus, textarea:focus, select:focus {
      border-color: var(--ink);
    }

    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    textarea#body {
      height: 480px;
      resize: vertical;
      font-family: 'Roboto Mono', 'Courier New', monospace;
      font-size: 0.9rem;
      line-height: 1.7;
    }

    /* ── Buttons ── */
    .btn {
      display: inline-block;
      padding: 0.65rem 1.5rem;
      font-family: var(--font);
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      border: none;
      border-radius: 3px;
      cursor: pointer;
      transition: opacity 0.15s;
    }

    .btn:hover { opacity: 0.8; }
    .btn-primary { background: var(--ink); color: white; }
    .btn-secondary { background: white; color: var(--ink); border: 1px solid var(--rule); }
    .btn-danger { background: white; color: #c0392b; border: 1px solid #e0c0be; font-size: 0.75rem; padding: 0.4rem 0.8rem; }

    .actions {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      padding-top: 1.5rem;
      border-top: 1px solid var(--rule);
      margin-top: 1.5rem;
    }

    .actions .spacer { flex: 1; }

    /* ── Status ── */
    .status {
      margin-top: 1rem;
      padding: 0.75rem 1rem;
      border-radius: 3px;
      font-size: 0.85rem;
      display: none;
    }

    .status.success { background: #e8f5e9; color: #2e7d32; display: block; }
    .status.error { background: #fdecea; color: #c62828; display: block; }
    .status.loading { background: #e3f2fd; color: #1565c0; display: block; }
  </style>
</head>
<body>
<div class="wrapper">

  <!-- ── Login Screen ── -->
  <div id="screen-login" class="screen active">
    <div class="login-box">
      <h1>montgomeree</h1>
      <p>Admin access only.</p>
      <div class="field">
        <label>Password</label>
        <input type="password" id="login-password" placeholder="Enter password" onkeydown="if(event.key==='Enter')login()">
      </div>
      <button class="btn btn-primary" onclick="login()">Sign in</button>
      <div id="login-error" class="status error" style="display:none">Incorrect password.</div>
    </div>
  </div>

  <!-- ── Setup Screen ── -->
  <div id="screen-setup" class="screen">
    <div class="setup-box">
      <h2>Connect to GitHub</h2>
      <p>This is a one-time setup. Your token is stored in this browser only — never in the repo.</p>

      <div class="field">
        <label>GitHub Personal Access Token</label>
        <input type="password" id="setup-token" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx">
      </div>
      <div class="row">
        <div class="field">
          <label>GitHub Username</label>
          <input type="text" id="setup-owner" placeholder="JohnoMontgomery">
        </div>
        <div class="field">
          <label>Repository Name</label>
          <input type="text" id="setup-repo" placeholder="montgomeree.com">
        </div>
      </div>
      <button class="btn btn-primary" onclick="saveSetup()">Save & Continue</button>
      <div id="setup-error" class="status error"></div>
    </div>
  </div>

  <!-- ── Write Screen ── -->
  <div id="screen-write" class="screen">
    <div class="admin-header">
      <h1>New Post</h1>
      <button class="btn btn-danger" onclick="resetSetup()">Reset GitHub config</button>
    </div>

    <div class="row">
      <div class="field">
        <label>Title</label>
        <input type="text" id="title" placeholder="The Coin on Its Edge">
      </div>
      <div class="field">
        <label>Date</label>
        <input type="date" id="date">
      </div>
    </div>

    <div class="field">
      <label>Category</label>
      <input type="text" id="category" placeholder="e.g. Theological, Observations, Practitioner-Researcher">
    </div>

    <div class="field">
      <label>Body (Markdown)</label>
      <textarea id="body" placeholder="Write your post here in Markdown..."></textarea>
    </div>

    <div class="actions">
      <button class="btn btn-secondary" onclick="clearForm()">Clear</button>
      <div class="spacer"></div>
      <button class="btn btn-primary" onclick="publish()">Publish →</button>
    </div>

    <div id="publish-status" class="status"></div>
  </div>

</div>

<script>
  // ── Config ──────────────────────────────────────────
  // CHANGE THIS PASSWORD to whatever you want
  const ADMIN_PASSWORD = 'montgomeree2026';
  // ────────────────────────────────────────────────────

  // Set today's date as default
  document.getElementById('date').valueAsDate = new Date();

  // Determine which screen to show on load
  function init() {
    const loggedIn = sessionStorage.getItem('admin_auth');
    if (!loggedIn) { show('screen-login'); return; }

    const token = localStorage.getItem('gh_token');
    const owner = localStorage.getItem('gh_owner');
    const repo  = localStorage.getItem('gh_repo');
    if (!token || !owner || !repo) { show('screen-setup'); return; }

    show('screen-write');
  }

  function show(id) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
  }

  // ── Login ────────────────────────────────────────────
  function login() {
    const pw = document.getElementById('login-password').value;
    if (pw === ADMIN_PASSWORD) {
      sessionStorage.setItem('admin_auth', '1');
      document.getElementById('login-error').style.display = 'none';
      init();
    } else {
      document.getElementById('login-error').style.display = 'block';
    }
  }

  // ── Setup ────────────────────────────────────────────
  function saveSetup() {
    const token = document.getElementById('setup-token').value.trim();
    const owner = document.getElementById('setup-owner').value.trim();
    const repo  = document.getElementById('setup-repo').value.trim();
    const err   = document.getElementById('setup-error');

    if (!token || !owner || !repo) {
      err.textContent = 'All fields are required.';
      err.className = 'status error';
      return;
    }

    localStorage.setItem('gh_token', token);
    localStorage.setItem('gh_owner', owner);
    localStorage.setItem('gh_repo', repo);
    show('screen-write');
  }

  function resetSetup() {
    if (!confirm('Reset GitHub config?')) return;
    localStorage.removeItem('gh_token');
    localStorage.removeItem('gh_owner');
    localStorage.removeItem('gh_repo');
    show('screen-setup');
  }

  // ── Publish ──────────────────────────────────────────
  async function publish() {
    const title    = document.getElementById('title').value.trim();
    const date     = document.getElementById('date').value;
    const category = document.getElementById('category').value.trim();
    const body     = document.getElementById('body').value.trim();
    const status   = document.getElementById('publish-status');

    if (!title || !date || !body) {
      status.textContent = 'Title, date and body are required.';
      status.className = 'status error';
      return;
    }

    const token = localStorage.getItem('gh_token');
    const owner = localStorage.getItem('gh_owner');
    const repo  = localStorage.getItem('gh_repo');

    // Build filename
    const slug = title.toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .substring(0, 60);
    const filename = `${date}-${slug}.md`;

    // Build front matter
    const frontmatter = [
      '---',
      `title: "${title}"`,
      `date: ${date}`,
      category ? `category: ${category}` : null,
      'layout: post',
      '---',
      '',
      body
    ].filter(l => l !== null).join('\n');

    // Encode to base64
    const encoded = btoa(unescape(encodeURIComponent(frontmatter)));

    status.textContent = 'Publishing...';
    status.className = 'status loading';

    try {
      const res = await fetch(
        `https://api.github.com/repos/${owner}/${repo}/contents/_posts/${filename}`,
        {
          method: 'PUT',
          headers: {
            'Authorization': `token ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            message: `Add post: ${title}`,
            content: encoded,
            branch: 'main'
          })
        }
      );

      if (res.ok) {
        status.textContent = `✓ Published. "${title}" is live in about 60 seconds.`;
        status.className = 'status success';
        clearForm();
      } else {
        const data = await res.json();
        status.textContent = `Error: ${data.message || 'GitHub API error'}`;
        status.className = 'status error';
      }
    } catch (e) {
      status.textContent = `Network error: ${e.message}`;
      status.className = 'status error';
    }
  }

  function clearForm() {
    document.getElementById('title').value = '';
    document.getElementById('category').value = '';
    document.getElementById('body').value = '';
    document.getElementById('date').valueAsDate = new Date();
  }

  init();
</script>
</body>
</html>
